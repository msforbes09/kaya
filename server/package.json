{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "drizzle-kit migrate && node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run --reporter=dot",
    "invite": "tsx src/scripts/invite.ts",
    "invite:prod": "node dist/scripts/invite.js",
    "forget": "tsx src/scripts/forget.ts",
    "forget:prod": "node dist/scripts/forget.js",
    "signout": "tsx src/scripts/signout.ts",
    "signout:prod": "node dist/scripts/signout.js"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.0.0",
    "@hono/node-server": "^1.13.0",
    "@hono/node-ws": "^1.1.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.30.0",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "postgres": "^3.4.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
