# --- Auth: one long random token; the PWA stores it once. Generate with: openssl rand -hex 32
KAYA_TOKEN=

# --- Claude Agent SDK
# Optional. Leave empty to use the Claude Code CLI login on this machine
# (run `claude auth status` to check). Set a key to bill the API directly instead.
ANTHROPIC_API_KEY=
# Directory the agent works in. Kaya runs on this Mac; point at the projects folder.
KAYA_WORKSPACE=/Volumes/Developer/Projects/Personal

# --- ElevenLabs (used for both Scribe STT and TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# --- Postgres (pgvector image)
DATABASE_URL=postgres://kaya:kaya@localhost:5432/kaya

# --- Server
PORT=8787
# In dev, Vite proxies to this. In prod the server serves web/dist itself.
